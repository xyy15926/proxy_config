[core]
	filemode = false
	editor = nvim
	autocrlf = input
	safecrlf = true
	quotepath = false
    hooksPath = ".githooks"
[user]
	name = xyy15926
	email = xyy15926@163.com
[alias]
	st = status
	ci = commit
	br = branch
	lg = "log --color --graph --pretty=format:' %Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit"
	df = difftool
[color]
	ui = true
[diff]
	tool = vimdiff
[difftool]
	prompt = false
[url "https://gh-proxy.org/https://github.com/"]
	insteadof = https://github.com/
